<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="MainWindow">
    <children>
        <TextField fx:id="userInput" layoutY="558.0"
                   onAction="#handleUserInput" prefHeight="40.0"
                   prefWidth="325.0" />
        <Button layoutX="324.0" layoutY="558.0"
                mnemonicParsing="false" onAction="#handleUserInput"
                prefHeight="40.0" prefWidth="76.0" text="Send" />
        <ScrollPane fx:id="scrollPane" fitToWidth="true"
                    hbarPolicy="NEVER" prefHeight="557.0"
                    prefWidth="400.0" vbarPolicy="ALWAYS">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="552.0"
                      prefWidth="388.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
